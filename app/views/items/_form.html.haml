= form_for @item do |form|
  %li.card.my-2
    .list-group-item.d-flex.justify-content-between.item_shadow.align-items-center{:class => ('bg-body-secondary' if item.status)}
      .d-grid.w-75
        = form.text_field :title, placeholder: 'Title', class: 'mb-1 ' + (item.status ? 'bg-body-secondary' : '')
        = form.text_field :description, placeholder: 'Description', class: ('bg-body-secondary' if item.status)
      %div
        = form.button type: 'submit', class: 'border-0 bg-transparent' do
          = bootstrap_icon 'floppy', height: 25, width: 25, fill: '#74a5b3'
        = form.button type: 'cancel', class: 'border-0 bg-transparent' do
          = bootstrap_icon 'x-lg', height: 25, width: 25, fill: '#74a5b3'